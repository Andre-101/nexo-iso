# syntax=docker/dockerfile:1
# Nginx stable Alpine slim: elimina utilidades innecesarias del runtime.
# Aplicar actualizaciones Alpine de seguridad en cada reconstruccion.
FROM nginx:1.30.6-alpine-slim AS web
RUN apk --no-cache upgrade
COPY infra/nginx.vps.conf /etc/nginx/nginx.conf
COPY proyecto/frontend/ /usr/share/nginx/html/
RUN rm -f /etc/nginx/conf.d/default.conf && \
    mkdir -p /tmp/nginx /var/cache/nginx && \
    chown -R 101:101 /tmp/nginx /var/cache/nginx /usr/share/nginx/html && \
    chmod -R a-w /usr/share/nginx/html
USER 101:101
ENTRYPOINT ["/usr/sbin/nginx", "-g", "daemon off;"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=4s --retries=3 CMD wget -q -O - http://127.0.0.1:8080/healthz | grep -q ok || exit 1
