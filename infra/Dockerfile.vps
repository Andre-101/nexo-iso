# syntax=docker/dockerfile:1
# Compilar SOLAMENTE en CI/GHCR; la VPS nunca ejecuta docker build.
FROM node:22-bookworm-slim AS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY proyecto/package.json proyecto/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci --no-audit --no-fund
COPY proyecto/prisma ./prisma
RUN DATABASE_URL='postgresql://build:build@127.0.0.1:5432/build?schema=public' \
    node node_modules/prisma/build/index.js validate && \
    DATABASE_URL='postgresql://build:build@127.0.0.1:5432/build?schema=public' \
    node node_modules/prisma/build/index.js generate

FROM dependencies AS production-dependencies
RUN npm prune --omit=dev --no-audit --no-fund

# Runtime: contiene motor Prisma, Poppler, CA, OpenSSL y solo dependencias reales.
FROM node:22-bookworm-slim AS api
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates poppler-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
# Preservar la salida generada por Prisma; npm prune puede depurar rutas no declaradas.
COPY --from=dependencies --chown=node:node /app/node_modules/.prisma ./node_modules/.prisma
COPY --chown=node:node proyecto/src ./src
COPY --chown=node:node proyecto/prisma/schema.prisma ./prisma/schema.prisma
COPY --chown=node:node proyecto/package.json ./package.json
RUN node -e "const fs=require('node:fs'),p='node_modules/.prisma/client/libquery_engine-'+(process.arch==='arm64'?'linux-arm64-openssl-3.0.x':'debian-openssl-3.0.x')+'.so.node';if(!fs.existsSync(p))throw Error('Prisma OpenSSL 3 engine faltante')" && \
    mkdir -p /app/private_uploads && chown 1000:1000 /app/private_uploads
ENV NODE_ENV=production PORT=3000 NODE_OPTIONS="--require=/app/src/config/load-secrets.js"
USER node:node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "src/server.js"]

# Herramienta administrativa aparte; NO ejecutarla automáticamente en cada deploy.
FROM node:22-bookworm-slim AS bootstrap
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node proyecto/prisma ./prisma
COPY --chown=node:node proyecto/src ./src
COPY --chown=node:node ["proyecto/Logica y encuesta.txt", "./Logica y encuesta.txt"]
COPY --chown=node:node proyecto/package.json ./package.json
ENV NODE_ENV=production NODE_OPTIONS="--require=/app/src/config/load-secrets.js"
USER node:node
CMD ["node", "src/ops/init-schema.js"]
