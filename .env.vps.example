# Copiar a .env.production SOLO en /opt/nexo. No contiene secretos.
NEXO_SECRETS_DIR=/opt/nexo/secrets
# Etiquetas publicadas por el pipeline GitHub Actions. Sustituir USUARIO y SHA.
NEXO_WEB_IMAGE=ghcr.io/USUARIO/nexo-web:sha-SHA
NEXO_API_IMAGE=ghcr.io/USUARIO/nexo-api:sha-SHA
NEXO_BOOTSTRAP_IMAGE=ghcr.io/USUARIO/nexo-bootstrap:sha-SHA
NEXO_DB_IMAGE=ghcr.io/USUARIO/nexo-db:sha-SHA
# No es necesario conocer aún el futuro dominio, el puerto público ni v4nex.
# Sin gateways autorizados, registro/finanzas quedan desactivados (sin simulación).
AI_ENABLED=0
AI_EXTERNAL_TRANSFER_APPROVED=0
AI_PROVIDER=anthropic
